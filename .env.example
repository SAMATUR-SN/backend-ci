# Modèle de configuration locale. Copier en .env (ignoré par Git), puis remplir :
#   cp .env.example .env
# Aucun vrai secret ici : les valeurs de déploiement viennent des credentials Jenkins.

# Base de données. compose.dev.yaml impose l'URL (db:5432) et l'utilisateur ;
# l'URL ci-dessous sert à lancer l'application depuis l'IDE, sur le port publié 5433.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/samatur_db
SPRING_DATASOURCE_USERNAME=postgres
# Mot de passe de la base locale, au choix (sert aussi à créer la base dans compose.dev.yaml)
SPRING_DATASOURCE_PASSWORD=

# Clé de signature des jetons : 32 caractères au minimum, sinon JJWT la refuse.
# Générer par exemple avec : openssl rand -base64 48
SAMATUR_JWT_SECRET=
# Durée de validité des jetons en millisecondes (8 heures)
SAMATUR_JWT_EXPIRATION=28800000

# Délai cible des alertes de retard, en jours (RG-05)
SAMATUR_DELAI_CIBLE_JOURS=15

# Mots de passe des comptes de démo, pour le test de connexion (facultatif, jamais dans le dépôt) :
# identifiant=mot de passe, séparés par des virgules. Sans cette variable, le test est ignoré.
SAMATUR_DEMO_MOTS_DE_PASSE=
