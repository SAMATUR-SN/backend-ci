meta {
  name: Indicateurs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/indicateurs
  body: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  I1 : part des jugements transcrits dans le délai cible (0 à 1). I2 : délai médian en jours entre détection et acte remis.
  I3 : élèves de CM2 sans acte remis à la date de référence. Filtres facultatifs : communeId, dateReference (AAAA-MM-JJ).
}
